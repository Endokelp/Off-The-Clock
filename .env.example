# Copy this file to .env and fill both values in. .env is not committed.

# The public SDK key for the Android app. In the RevenueCat dashboard, open Apps and providers,
# add a Test Store, and paste the key it hands back. Without this the app still logs shifts and
# finds violations, and the record screen says it is switched off rather than failing.
EXPO_PUBLIC_REVENUECAT_KEY=

# The parent rail. Create a Web Purchase Link for the same offering and copy the token out of the
# sandbox URL, which is the part after https://pay.rev.cat/ and before any customer id. The app
# appends its own customer id, so paste the token alone.
EXPO_PUBLIC_REVENUECAT_WEB_TOKEN=
